# Server-only. Never prefix these with NEXT_PUBLIC_, and do not commit real keys.

# Chat, new project ideas, pictures, and Hear this.
OPENROUTER_API_KEY=

# Optional overrides. The speech voice must be one the speech model supports.
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_SPEECH_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_SPEECH_VOICE=alloy
